# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./research_platform.db
# For PostgreSQL: DATABASE_URL=postgresql://rfiip:rfiip_secret@db:5432/research_platform

# ── Authentication ────────────────────────────────────────────
SECRET_KEY=your_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── External APIs ─────────────────────────────────────────────
# OPENALEX_API_KEY=your_key_if_used

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ── PostgreSQL (when using docker-compose db service) ─────────
# POSTGRES_USER=rfiip
# POSTGRES_PASSWORD=rfiip_secret
# POSTGRES_DB=research_platform
