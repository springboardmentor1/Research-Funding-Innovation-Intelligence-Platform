# Secret key for signing JWT tokens
SECRET_KEY=antigravity-super-secret-jwt-key-for-milestone1-capstone

# Database URL (SQLite or PostgreSQL / Neon)
# SQLite:
DATABASE_URL=sqlite:///./innovation_platform.db
# PostgreSQL / Neon:
# DATABASE_URL=postgresql://user:password@your-neon-hostname.neon.tech/neondb?sslmode=require

# OpenAlex API Key (obtained from openalex.org/settings/api)
OPENALEX_API_KEY=

# USPTO Open Data Portal API Key (obtained from data.uspto.gov API portal)
USPTO_ODP_API_KEY=
