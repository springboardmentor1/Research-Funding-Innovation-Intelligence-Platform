# Database Connection URL (e.g. postgresql://user:password@localhost:5432/dbname)
DATABASE_URL=

# MongoDB Connection String (for document-based caching/logs)
MONGODB_URI=

# OpenAlex Base Endpoint (defaults to https://api.openalex.org)
OPENALEX_BASE_URL=https://api.openalex.org

# OpenAlex API Premium Token (Optional, polite pool used by default)
OPENALEX_API_KEY=

# The Lens API Token (for patent searches)
LENS_API_KEY=

# Security configurations for JWT Tokens
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------------------------------------------------------
# Ingestion System Configuration
# -------------------------------------------------------

# Number of records to fetch per API call (1–500 depending on API plan)
INGESTION_BATCH_SIZE=100

# How often scheduled ingestion runs (in hours)
INGESTION_SCHEDULE_HOURS=24

# Max records fetched per scheduled run
SCHEDULED_MAX_RECORDS=5000

# Query used for scheduled OpenAlex publication ingestion
SCHEDULED_PUBLICATION_QUERY=artificial intelligence machine learning

# Query used for scheduled Lens patent ingestion
SCHEDULED_PATENT_QUERY=artificial intelligence
