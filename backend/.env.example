# Database Connection URL (e.g. postgresql://user:password@localhost:5432/dbname)
DATABASE_URL=

# MongoDB Connection String (for document-based caching/logs)
MONGODB_URI=

# OpenAlex Base Endpoint (defaults to https://api.openalex.org)
OPENALEX_BASE_URL=https://api.openalex.org

# OpenAlex API Premium Token (Optional, polite pool used by default)
OPENALEX_API_KEY=

# The Lens API Token (for patent searches)
LENS_API_KEY=

# Security configurations for JWT Tokens
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
